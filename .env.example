# Copy this file to .env and fill it in.   (Windows PowerShell:  copy .env.example .env)
# .env is ignored by git, so your real values never reach GitHub. Only this example file is committed.
# On the hosting platform, enter the same variables in its dashboard instead of using a file.

# development | production   (production turns on HTTPS-only cookies, HSTS, CSP and refuses unsafe settings)
NODE_ENV=development
PORT=4000

# MySQL. Locally: XAMPP defaults (root, empty password). Hosted: values from your database provider.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=team3_store
# Hosted MySQL usually needs an encrypted connection: set to true there.
DB_SSL=false

# Signs every JWT. Production REQUIRES a long random value (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL=2h

# bcrypt cost factor (2^cost rounds). 10 is standard; 12 is slower and stronger. Allowed: 10-14.
BCRYPT_COST=10

# How many proxies sit in front of the server (the host's HTTPS layer = 1). Leave empty locally.
TRUST_PROXY=

# Sign-in protection
LOGIN_LOCK_AFTER=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_LIMIT=30
LOGIN_IP_WINDOW_MINUTES=15
TRUSTED_DEVICE_DAYS=180
